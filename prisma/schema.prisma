datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // SUPER_ADMIN, EVENT_HEAD, ARENA_HEAD, ACCESS_OFFICER, MISSION_MARSHAL, JUDGE, VOLUNTEER, PARTICIPANT
  arenaId      String?
  createdAt    DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  code        String   @unique // EM, UC
  title       String   // ENGINEER'S MIND, ENGINEERING UNDERCOVER
  description String
  status      String   @default("NOT_STARTED") // NOT_STARTED, READY, ACTIVE, PAUSED, COMPLETED, EMERGENCY_HOLD
  rounds      MissionRound[]
  teams       Team[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventClockState {
  id                        String    @id @default(uuid())
  eventCode                 String    @unique
  status                    String    @default("NOT_STARTED") // NOT_STARTED, ACTIVE, PAUSED, EMERGENCY_HOLD
  simulatedTimeOffsetSeconds Int       @default(0) // Time warp offset in seconds
  activeRoundNumber         Int       @default(1)
  roundStartedAt            DateTime?
  roundEndsAt               DateTime?
  updatedAt                 DateTime  @updatedAt
}

model Team {
  id            String   @id @default(uuid())
  eventCode     String   // EM, UC
  teamCode      String   @unique // EM-01, UC-12
  teamName      String
  qrToken       String   @unique // tok_em01_xvas9ha5
  isRevoked     Boolean  @default(false)
  leaderName    String
  memberNames   String   // JSON string of names
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime @default(now())

  event         Event    @relation(fields: [eventCode], references: [code])
  submissions   Submission[]
  scores        Score[]
  accessLogs    AccessLog[]
}

model Mission {
  id            String   @id @default(uuid())
  eventCode     String   // EM, UC
  roundNumber   Int
  title         String
  description   String
  maxScore      Int      @default(100)
  createdAt     DateTime @default(now())

  fields        MissionField[]
  rubrics       Rubric[]
  submissions   Submission[]
  scores        Score[]
}

model MissionRound {
  id              String   @id @default(uuid())
  eventCode       String
  roundNumber     Int
  title           String
  scheduledStart  DateTime
  scheduledEnd    DateTime
  durationMinutes Int

  event           Event    @relation(fields: [eventCode], references: [code])
}

model MissionField {
  id            String   @id @default(uuid())
  missionId     String
  fieldKey      String
  fieldType     String   // SHORT_TEXT, LONG_TEXT, MULTIPLE_CHOICE, NUMBER
  label         String
  optionsJson   String?  // JSON string for choices
  isRequired    Boolean  @default(true)
  orderIndex    Int      @default(0)

  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Submission {
  id            String   @id @default(uuid())
  teamId        String
  missionId     String
  roundNumber   Int
  submittedAt   DateTime @default(now())
  isLate        Boolean  @default(false)
  status        String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, SCORED
  
  team          Team     @relation(fields: [teamId], references: [id])
  mission       Mission  @relation(fields: [missionId], references: [id])
  answers       SubmissionAnswer[]
  scores        Score[]
}

model SubmissionAnswer {
  id            String   @id @default(uuid())
  submissionId  String
  fieldKey      String
  answerValue   String

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Rubric {
  id            String   @id @default(uuid())
  missionId     String
  criterion     String
  maxMarks      Int
  description   String

  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Score {
  id            String   @id @default(uuid())
  submissionId  String
  teamId        String
  missionId     String
  judgeId       String
  totalScore    Float
  isFinalized   Boolean  @default(false)
  comments      String?
  scoredAt      DateTime @default(now())

  submission    Submission @relation(fields: [submissionId], references: [id])
  team          Team       @relation(fields: [teamId], references: [id])
  mission       Mission    @relation(fields: [missionId], references: [id])
  scoreItems    ScoreItem[]
}

model ScoreItem {
  id            String   @id @default(uuid())
  scoreId       String
  rubricId      String
  marksAwarded  Float

  score         Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id            String   @id @default(uuid())
  teamId        String?
  qrToken       String
  scanType      String   // ENTRANCE_VERIFICATION, MISSION_CLEARANCE, PACKET_UNSEAL
  status        String   // GRANTED, LOCKED, REVOKED, INVALID
  timestamp     DateTime @default(now())
  details       String?

  team          Team?    @relation(fields: [teamId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorEmail    String
  actorRole     String
  action        String   // CLOCK_START, CLOCK_PAUSE, REISSUE_QR, PASS_REVOKE, SCORE_FINALIZED
  targetEntity  String
  details       String
  timestamp     DateTime @default(now())
}

model TieBreakConfig {
  id                String   @id @default(uuid())
  eventCode         String   @unique
  tier1Criterion    String   @default("TOTAL_SCORE") // HIGHEST TOTAL SCORE
  tier2Criterion    String   @default("COMPLEXITY_MISSION_SCORE") // HIGHEST SCORE IN FINAL/COMPLEX MISSION
  tier3Criterion    String   @default("EARLIEST_SUBMISSION") // EARLIEST SUBMISSION TIMESTAMP
}

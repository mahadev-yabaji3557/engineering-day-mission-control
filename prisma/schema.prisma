datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // SUPER_ADMIN, EVENT_HEAD, ARENA_HEAD, ACCESS_OFFICER, MISSION_MARSHAL, JUDGE, VOLUNTEER, PARTICIPANT
  arenaId      String?
  createdAt    DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  code        String   @unique // EM, UC
  title       String   // ENGINEER'S MIND, ENGINEERING UNDERCOVER
  description String
  status      String   @default("NOT_STARTED") // NOT_STARTED, READY, ACTIVE, PAUSED, COMPLETED, EMERGENCY_HOLD
  createdAt   DateTime @default(now())

  teams       Team[]
  missions    Mission[]
  rounds      MissionRound[]
  clockState  EventClockState?
}

model EventClockState {
  id                          String    @id @default(uuid())
  eventId                     String    @unique
  status                      String    @default("NOT_STARTED") // NOT_STARTED, ACTIVE, PAUSED, EMERGENCY_HOLD, COMPLETED
  startTime                   DateTime?
  pausedAt                    DateTime?
  totalPausedSeconds          Int       @default(0)
  simulatedTimeOffsetSeconds Int       @default(0) // Used by Test Mode time warp
  emergencyNotice             String?
  allowSubmissionsDuringPause Boolean   @default(false)
  updatedAt                   DateTime  @updatedAt

  event                       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Arena {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  code      String
  location  String
}

model Team {
  id        String   @id @default(uuid())
  eventId   String
  teamCode  String   // e.g. EM-01, UC-07
  teamName  String
  members   String   // JSON string array of member names
  qrToken   String   @unique // High entropy random token, e.g. tok_em01_9f8a7b6c
  status    String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions Submission[]
  accessLogs  AccessLog[]
  scores      Score[]
}

model Mission {
  id          String   @id @default(uuid())
  eventId     String
  missionCode String   // e.g. EM-01, EM-02, EM-F
  title       String
  description String
  instructions String
  totalPoints Int      @default(20)
  arenaId     String?

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields      MissionField[]
  rubrics     Rubric[]
  rounds      MissionRound[]
  submissions Submission[]
  scores      Score[]
  accessLogs  AccessLog[]
}

model MissionRound {
  id              String   @id @default(uuid())
  eventId         String
  missionId       String
  roundNumber     Int
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  status          String   @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, PAUSED

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionField {
  id          String   @id @default(uuid())
  missionId   String
  fieldKey    String
  label       String
  fieldType   String   // SHORT_TEXT, LONG_TEXT, MCQ, RANKING, EVIDENCE, JUSTIFICATION, CONFIDENCE
  options     String?  // JSON string for options if MCQ or ranking
  required    Boolean  @default(true)
  order       Int      @default(0)

  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String   @id @default(uuid())
  teamId      String
  eventId     String
  missionId   String
  submittedAt DateTime @default(now())
  status      String   @default("SUBMITTED") // DRAFT, SUBMITTED, LATE, LOCKED
  isLate      Boolean  @default(false)

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  answers     SubmissionAnswer[]
}

model SubmissionAnswer {
  id           String   @id @default(uuid())
  submissionId String
  fieldKey     String
  answerValue  String

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Rubric {
  id        String  @id @default(uuid())
  missionId String
  criteria  String
  maxMarks  Float
  weight    Float   @default(1.0)

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scoreItems ScoreItem[]
}

model JudgeAssignment {
  id        String @id @default(uuid())
  judgeId   String
  eventId   String
  missionId String
  teamId    String
}

model Score {
  id          String    @id @default(uuid())
  judgeId     String
  teamId      String
  missionId   String
  totalScore  Float     @default(0.0)
  comments    String?
  status      String    @default("DRAFT") // DRAFT, FINALIZED
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  scoreItems  ScoreItem[]
}

model ScoreItem {
  id         String @id @default(uuid())
  scoreId    String
  rubricId   String
  marksGiven Float

  score      Score  @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  rubric     Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id              String    @id @default(uuid())
  teamId          String
  eventId         String
  missionId       String?
  qrStatus        String    // VALID, REVOKED, INVALID
  clearanceStatus String    // GRANTED, LOCKED, DENIED
  officerId       String?
  packetOpened    Boolean   @default(false)
  packetOpenedAt  DateTime?
  marshalId       String?
  timestamp       DateTime  @default(now())

  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mission         Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorRole String
  action    String
  target    String
  oldValue  String?
  newValue  String?
  ipAddress String?
  timestamp DateTime @default(now())
}

model TieBreakConfig {
  id           String @id @default(uuid())
  eventId      String @unique
  priorityRule String // e.g. "FINAL_ROUND_FIRST,REASONING_SCORE_SECOND,EARLIEST_SUBMISSION_THIRD,EVENT_HEAD_DECISION"
}
